    "item":  [
                 {
                     "request":  {
                                     "body":  {
                                                  "raw":  "{\"nom\":\"TestV6\",\"prenom\":\"Amine\",\"email\":\"postman.v6@example.com\",\"actif\":true}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              },
                                     "method":  "POST",
                                     "url":  "{{patients}}/api/patients",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 },
                     "name":  "01 - Creer patient actif",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"Patient cree : 201\", () =\u003e pm.response.to.have.status(201));\nif (pm.response.code === 201) {\n  pm.collectionVariables.set(\"patientId\", pm.response.json().id);\n}"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "request":  {
                                     "body":  {
