                     "name":  "02 - Creer praticien actif",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"Praticien cree : 201\", () =\u003e pm.response.to.have.status(201));\nif (pm.response.code === 201) {\n  pm.collectionVariables.set(\"praticienId\", pm.response.json().id);\n}"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "request":  {
                                     "body":  {
