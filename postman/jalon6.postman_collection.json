                                     "url":  "{{rendezvous}}/api/rendezvous",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "idempotencyKey",
                                                        "value":  "{{cleV6}}"
                                                    }
                                                ]
                                 },
                     "name":  "03 - Creer rendez-vous",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"Rendez-vous cree : 201\", () =\u003e pm.response.to.have.status(201));\nif (pm.response.code === 201) {\n  pm.collectionVariables.set(\"rdvId\", pm.response.json().id);\n}"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   },
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.collectionVariables.set(\"cleV6\", pm.variables.replaceIn(\"{{$guid}}\"));\nconst d = new Date();\nd.setDate(d.getDate() + 30);\nd.setHours(14, 30, 0, 0);\nconst pad = n =\u003e String(n).padStart(2, \"0\");\nconst date = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T14:30:00`;\npm.collectionVariables.set(\"dateHeure\", date);"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "prerequest"
                                   }
                               ]
                 },
                 {
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{rendezvous}}/api/rendezvous/{{rdvId}}/detail",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ]
                                 },
                     "name":  "04 - Consultation enrichie",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"Consultation : 200\", () =\u003e pm.response.to.have.status(200));\npm.test(\"Patient et praticien disponibles\", () =\u003e {\n  const d = pm.response.json();\n  pm.expect(d.patient).to.not.equal(null);\n  pm.expect(d.praticien).to.not.equal(null);\n});"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
                 },
                 {
                     "request":  {
                                     "body":  {
                                                  "raw":  "{\"patientId\":{{patientId}},\"praticienId\":{{praticienId}},\"dateHeure\":\"{{dateHeure}}\"}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              },
                                                  "mode":  "raw"
                                              },
                                     "method":  "POST",
                                     "url":  "{{rendezvous}}/api/rendezvous",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    },
                                                    {
                                                        "key":  "idempotencyKey",
                                                        "value":  "{{cleV6}}"
                                                    }
                                                ]
                                 },
                     "name":  "05 - Rejeu exact meme cle",
                     "event":  [
                                   {
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"Rejeu refuse : 400\", () =\u003e pm.response.to.have.status(400));\npm.test(\"Operation deja traitee\", () =\u003e {\n  pm.expect(pm.response.text()).to.include(\"Operation deja traitee\");\n});"
                                                               ],
                                                      "type":  "text/javascript"
                                                  },
                                       "listen":  "test"
                                   }
                               ]
